# ==========================================
# WhatsApp AI Assistant (Antigravity Engine)
# ==========================================

# Configuração do Servidor FastAPI
PORT=8055
HOST=0.0.0.0

# Configurações da Evolution API (WhatsApp)
EVOLUTION_URL=https://evolution.quantisia.com.br
EVOLUTION_APIKEY=sua_chave_evolution_aqui
EVOLUTION_INSTANCE=01

# Controle de Acesso (Números autorizados separados por vírgula com DDI+DDD)
OWNER_NUMBERS=554388597348,5543988597348

# Motor Antigravity (agy CLI)
USE_ANTIGRAVITY_AGENT=true
AGY_BIN_PATH=/root/.local/bin/agy
AGY_WORKSPACE=/root
AGY_TIMEOUT=180
AGY_EFFORT=low

# Chave e Modelo do Google Gemini (Fallback e Transcrição Multimodal)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Banco de Dados de Conversas
DB_PATH=data/conversations.db
